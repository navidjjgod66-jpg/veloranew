{
  "name": "velora-store",
  "version": "1.0.0",
  "private": true,
  "description": "VELORA — Luxury footwear storefront with a Persian RTL, mobile-first experience.",
  "type": "module",
  "scripts": {
    "lint": "eslint assets/js --ext .js",
    "format": "prettier --write \"assets/**/*.{js,css,html}\" \"tests/**/*.{js,mjs}\" \"index.html\" \"*.md\"",
    "format:check": "prettier --check \"assets/**/*.{js,css,html}\" \"tests/**/*.{js,mjs}\" \"index.html\" \"*.md\"",
    "syntax": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "check": "npm run syntax && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
